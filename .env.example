# trios-mcp — local environment template.
# Copy this file to .env and fill in real values LOCALLY.
# Do NOT commit .env. Rule 5 of AGENTS.md forbids committing DSNs / tokens.

# Absolute paths to the wrapped CLI binaries from gHashTag/trios-trainer-igla.
# Fall back to PATH lookup if unset.
TRIOS_TRI_BIN=/abs/path/trios-trainer-igla/target/release/tri
TRIOS_IGLA_BIN=/abs/path/trios-trainer-igla/target/release/trios-igla

# Logging — stderr only. stdout is reserved for JSON-RPC (see rule 02).
RUST_LOG=info

# Railway / Postgres DSNs used by the wrapped CLIs. Reference by NAME in code,
# docs, and commits — never paste values into the repo.
TRIOS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# MATRIX_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Optional: training-canon identifier used by tri/trios-igla. Reference only by name.
# Example value (illustrative, do not reuse): IGLA-SHORT-WAVE-MATRIX-bf16-h128-LR0.0001-rng1597-sgdm
TRIOS_CANON_NAME=

# Optional Railway API token (only for non-MCP automation). Revoke immediately if exposed.
# RAILWAY_TOKEN=
